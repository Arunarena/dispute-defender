# Copy this file to .env and fill in what you have.
# Everything is optional: with nothing set, the app runs in demo mode.

# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: PayPal webhook ID (developer.paypal.com -> your app -> Webhooks).
# Subscribe to CUSTOMER.DISPUTE.CREATED, URL: https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Claude API key (console.anthropic.com). Without it, a scripted agent stands in.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000
