# Copy this file to .env and fill in what you have.
# Everything is optional: with nothing set, the app runs in demo mode.

# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: PayPal webhook ID (developer.paypal.com -> your app -> Webhooks).
# URL: https://<your-host>/api/webhooks/paypal
# Events: CUSTOMER.DISPUTE.CREATED, CUSTOMER.DISPUTE.UPDATED, CUSTOMER.DISPUTE.RESOLVED, PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=
# Also turn on "Transaction search" in your app's features so the agent can read buyer history.

# Claude API key (console.anthropic.com). Without it, a scripted agent stands in.
ANTHROPIC_API_KEY=

# ---- Optional integrations (see docs/INTEGRATIONS.md). Each one turns on by itself. ----

# Live carrier tracking (goshippo.com -> Settings -> API). A shippo_test_ key works with test number SHIPPO_DELIVERED.
SHIPPO_API_KEY=

# Risk Radar address checks (Google Cloud key with the Address Validation API enabled).
GOOGLE_MAPS_API_KEY=

# Alerts: Slack incoming webhook, Discord channel webhook, and/or any automation webhook (Zapier, Make, n8n).
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
OUTBOUND_WEBHOOK_URL=
# Signs automation payloads: header X-Defender-Signature: sha256=<HMAC of the raw body>
OUTBOUND_WEBHOOK_SECRET=

# Signs NFC Tap-to-Confirm tag links. Optional: one is generated and saved in data/ if empty.
NFC_TAG_SECRET=

# Public address for links in alerts and the calendar feed (Render sets RENDER_EXTERNAL_URL for you).
# PUBLIC_URL=https://dispute-defender.example.com
# DEADLINE_ALERT_HOURS=48

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000
